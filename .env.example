# ==============================================================================
# OptiAsset CMMS — Enterprise Asset & Industrial Maintenance Architecture
# Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Primary PostgreSQL Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/optiasset_db

# Security & Authentication
JWT_SECRET=replace-with-a-cryptographically-secure-random-key-in-production

# Enterprise ERP Bridge (Legacy MSSQL Database)
ERP_DB_HOST=localhost
ERP_DB_PORT=1433
ERP_DB_USER=sa
ERP_DB_PASSWORD=your-strong-mssql-password
ERP_DB_NAME=ERP_ENTERPRISE_DB

# Optional Cloud Storage (AWS S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=optiasset-cmms-assets

# Frontend Demo Mode (Set to true for Vercel/standalone preview mode)
VITE_DEMO_MODE=false
